# Bronze data is too large for git: it lives on the collector VM and in the local copy made by
# bronze_sync (outside the repository). data/bronze/ is only the default for local test runs.
# The GitHub Actions backup under data/github-backup/ IS committed, and so is the one-off probe
# evidence under docs/evidence/ (.pb / .csv); do not ignore those.
data/bronze/
# python
__pycache__/
*.pyc
.venv/
venv/
# misc
.env
.DS_Store
*.tmp
.pytest_cache/
.ruff_cache/
# private keys
*.pem
*.key
*:Zone.Identifier
# output of the T01 practice script (the script itself lives only on the t01-weather-downloader branch)
practice/output/
.claude/settings.local.json