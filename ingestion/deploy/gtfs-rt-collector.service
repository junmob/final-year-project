[Unit]
Description=GTFS Realtime collector (rapid-bus-kl, rapid-bus-mrtfeeder)
After=network-online.target
Wants=network-online.target

[Service]
# 部署时把 ubuntu 和路径改成 VM 上实际的用户名与仓库位置
User=ubuntu
WorkingDirectory=/home/ubuntu/final-year-project
ExecStart=/home/ubuntu/final-year-project/.venv/bin/python ingestion/collect_gtfs_rt.py
Restart=always
RestartSec=10
# 日志用 journalctl -u gtfs-rt-collector 查看
Environment=PYTHONUNBUFFERED=1

[Install]
WantedBy=multi-user.target
