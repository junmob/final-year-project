[Unit]
Description=GTFS Realtime collector (rapid-bus-kl, rapid-bus-mrtfeeder)
After=network-online.target time-sync.target
Wants=network-online.target

[Service]
User=ubuntu
WorkingDirectory=/home/ubuntu/fyp
ExecStart=/home/ubuntu/fyp/.venv/bin/python ingestion/collect_gtfs_rt.py
Environment=PYTHONUNBUFFERED=1
Environment=BRONZE_DIR=/home/ubuntu/fyp-data/bronze
Restart=always
RestartSec=10
MemoryMax=300M
# Logs: journalctl -u gtfs-rt-collector

[Install]
WantedBy=multi-user.target
