[Unit]
Description=Archive MET Malaysia weather warnings (stored only when changed)
After=network-online.target
Wants=network-online.target

[Service]
Type=oneshot
User=ubuntu
WorkingDirectory=/home/ubuntu/fyp
ExecStart=/home/ubuntu/fyp/.venv/bin/python ingestion/download_weather.py --only weather_warning
Environment=PYTHONUNBUFFERED=1
Environment=BRONZE_DIR=/home/ubuntu/fyp-data/bronze
TimeoutStartSec=15min
Nice=5
